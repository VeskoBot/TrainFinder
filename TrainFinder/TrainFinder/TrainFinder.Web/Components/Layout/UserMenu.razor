@using Microsoft.AspNetCore.Components.Authorization
@rendermode InteractiveServer

<div class="nav-user">
    <div class="user-pill" @onclick="ToggleUserMenu">
        <span class="user-icon material-icons">account_circle</span>
        <AuthorizeView>
            <Authorized>
                <span class="user-name">@context.User.Identity?.Name</span>
            </Authorized>
        </AuthorizeView>
    </div>
    @if (_showUserMenu)
    {
        <div class="user-dropdown">
            <AuthorizeView>
                <Authorized>
                    <a href="/profile" data-enhance-nav="false">Редактирай профил</a>
                    <a href="MicrosoftIdentity/Account/SignOut" data-enhance-nav="false">Изход</a>
                </Authorized>
                <NotAuthorized>
                    <a href="MicrosoftIdentity/Account/SignIn" data-enhance-nav="false">Влезете в акаунт</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    }
</div>
